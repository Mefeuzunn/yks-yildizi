# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage

# next.js & build outputs
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# environment files (strictly never commit secrets)
.env*
!.env.example

# database & SQLite storage (never commit user databases or journal files)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# debug & error logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# system & misc
.DS_Store
*.pem
.idea/

# vercel
.vercel

# scratch scripts and local migration utilities
scripts/scratch/
patch_sidebar.js
yks_dev.db

# PWA files
**/public/sw.js
**/public/sw.js.map
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/swe-worker-*.js
